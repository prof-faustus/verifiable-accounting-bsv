{
  "name": "verifiable-accounting-bsv",
  "version": "0.1.0",
  "description": "BSV-native audit evidence system: per-field selective disclosure over an intra-transaction Merkle field tree, anchored on the Bitcoin (BSV) header chain.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/bsv",
    "packages/merkle",
    "packages/proofstore",
    "packages/evidence",
    "packages/api",
    "packages/cli",
    "packages/simstore",
    "packages/simstudy"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "lint": "node scripts/format-check.mjs && node scripts/forbidden-scan.mjs",
    "format:check": "node scripts/format-check.mjs",
    "scan": "node scripts/forbidden-scan.mjs",
    "test": "node scripts/run-tests.mjs",
    "selftest": "node packages/cli/dist/index.js selftest",
    "reproduce": "node packages/cli/dist/index.js reproduce",
    "study:store": "node packages/simstore/dist/main.js --ci",
    "study:assurance": "node packages/simstudy/dist/main.js --ci"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "typescript": "5.7.3"
  }
}
